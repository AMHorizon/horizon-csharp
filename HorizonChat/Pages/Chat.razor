@page "/chat"
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using System.Net.WebSockets
@using System.Text
@using System.Text.Json
@implements IAsyncDisposable

<PageTitle>Horizon Chat</PageTitle>

<div class="chat-container">
    <div class="chat-header">
        <h2>Horizon Chat</h2>
        <span class="username-badge">@username</span>
    </div>
    
    <div class="chat-messages" id="chatMessages">
        @foreach (var message in messages)
        {
            <div class="message @(message.Username == username ? "own-message" : "")">
                <div class="message-header">
                    <span class="message-username">@message.Username</span>
                    <span class="message-time">@message.Timestamp.ToString("HH:mm")</span>
                </div>
                <div class="message-content">@message.Content</div>
            </div>
        }
    </div>
    
    <div class="chat-input">
        <input type="text" 
               class="form-control" 
               placeholder="Type a message..." 
               @bind="currentMessage" 
               @bind:event="oninput"
               @onkeydown="HandleKeyPress"
               disabled="@(!isConnected)" />
        <button class="btn btn-primary" 
                @onclick="SendMessage" 
                disabled="@(string.IsNullOrWhiteSpace(currentMessage) || !isConnected)">
            Send
        </button>
    </div>
    
    <div class="connection-status @(isConnected ? "connected" : "disconnected")">
        @(isConnected ? "Connected" : connectionError != null ? $"Error: {connectionError}" : "Connecting...")
    </div>
</div>

@code {
    private ClientWebSocket? webSocket;
    private string username = "";
    private string currentMessage = "";
    private List<ChatMessage> messages = new();
    private bool isConnected = false;
    private string? connectionError;
    private CancellationTokenSource? cancellationTokenSource;

    protected override async Task OnInitializedAsync()
    {
        // Get username from query string
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        username = query["username"] ?? "Guest";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ConnectToWebSocket();
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('chatMessages').scrollTop = document.getElementById('chatMessages').scrollHeight");
        }
    }

    private async Task ConnectToWebSocket()
    {
        try
        {
            connectionError = null;
            webSocket = new ClientWebSocket();
            cancellationTokenSource = new CancellationTokenSource();
            
            var uri = new Uri(NavigationManager.BaseUri);
            var scheme = uri.Scheme == "https" ? "wss" : "ws";
            var wsUri = new Uri($"{scheme}://{uri.Host}:{uri.Port}/ws?username={Uri.EscapeDataString(username)}");
            
            await webSocket.ConnectAsync(wsUri, cancellationTokenSource.Token);
            isConnected = true;
            await InvokeAsync(StateHasChanged);
            
            // Start receiving messages
            _ = Task.Run(async () => await ReceiveMessages());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"WebSocket connection error: {ex.Message}");
            connectionError = ex.Message;
            isConnected = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReceiveMessages()
    {
        var buffer = new byte[1024 * 4];
        
        try
        {
            while (webSocket?.State == WebSocketState.Open && cancellationTokenSource?.Token.IsCancellationRequested == false)
            {
                var result = await webSocket.ReceiveAsync(new ArraySegment<byte>(buffer), cancellationTokenSource.Token);
                
                if (result.MessageType == WebSocketMessageType.Close)
                {
                    await webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, "", CancellationToken.None);
                    isConnected = false;
                    await InvokeAsync(StateHasChanged);
                    break;
                }
                
                var messageJson = Encoding.UTF8.GetString(buffer, 0, result.Count);
                var message = JsonSerializer.Deserialize<ChatMessage>(messageJson);
                
                if (message != null)
                {
                    messages.Add(message);
                    await InvokeAsync(async () =>
                    {
                        StateHasChanged();
                        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('chatMessages').scrollTop = document.getElementById('chatMessages').scrollHeight");
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Receive error: {ex.Message}");
            isConnected = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || webSocket?.State != WebSocketState.Open)
            return;

        try
        {
            var message = new ChatMessage
            {
                Username = username,
                Content = currentMessage.Trim(),
                Timestamp = DateTime.Now
            };
            
            var messageJson = JsonSerializer.Serialize(message);
            var messageBytes = Encoding.UTF8.GetBytes(messageJson);
            
            await webSocket.SendAsync(
                new ArraySegment<byte>(messageBytes),
                WebSocketMessageType.Text,
                true,
                CancellationToken.None);
            
            currentMessage = "";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Send error: {ex.Message}");
            connectionError = $"Send failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(currentMessage))
        {
            await SendMessage();
        }
    }

    public async ValueTask DisposeAsync()
    {
        cancellationTokenSource?.Cancel();
        
        if (webSocket?.State == WebSocketState.Open)
        {
            await webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, "Client disconnecting", CancellationToken.None);
        }
        
        webSocket?.Dispose();
        cancellationTokenSource?.Dispose();
    }

    private class ChatMessage
    {
        public string Username { get; set; } = "";
        public string Content { get; set; } = "";
        public DateTime Timestamp { get; set; }
    }
}
